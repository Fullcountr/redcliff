<?xml version='1.0' encoding='UTF-16'?><Properties version='1.1'><Common><Context type='int'>1</Context><Variant type='string'>11</Variant></Common><Connection><Server modified='1' type='string'><![CDATA[SALES_DB]]></Server></Connection><Usage><ReadMode type='int'><![CDATA[0]]></ReadMode><GenerateSQL modified='1' type='bool'><![CDATA[0]]></GenerateSQL><SQL><SelectStatement collapsed='1' modified='1' type='string'><![CDATA[SELECT ORDER_ID, CUSTOMER_ID, ORDER_DATE, STATUS, AMOUNT FROM SALES.ORDERS]]></SelectStatement></SQL></Usage></Properties>
=+=+=+=
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
