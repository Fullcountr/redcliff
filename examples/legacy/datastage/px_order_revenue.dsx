   BEGIN DSRECORD
      Identifier "V0S7"
      OLEType "CTransformerStage"
      Readonly "0"
      Name "xfm_prepare"
      InputPins "V0S7P1"
      OutputPins "V0S7P2"
      StageVars "CStageVar"
      BEGIN DSSUBRECORD
         Name "svAmountUsd"
         Expression "lnk_with_customer.AMOUNT * FxRate"
         SqlType "3"
         Precision "12"
         Scale "2"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S7P1"
      OLEType "CTrxInput"
      Readonly "0"
      Name "lnk_with_customer"
      Partner "V0S6|V0S6P3"
      LinkType "1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S7P2"
      OLEType "CTrxOutput"
      Readonly "0"
      Name "lnk_prepared"
      Partner "V0S10|V0S10P1"
      Reject "0"
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "ORDER_ID"
         SqlType "4"
         Precision "10"
         Scale "0"
         Nullable "0"
         Derivation "lnk_with_customer.ORDER_ID"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "CUSTOMER_ID"
         SqlType "4"
         Precision "10"
         Scale "0"
         Nullable "1"
         Derivation "lnk_with_customer.CUSTOMER_ID"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "CUSTOMER_NAME"
         SqlType "12"
         Precision "101"
         Scale "0"
         Nullable "1"
         Derivation "Trim(lnk_with_customer.FIRST_NAME) : \" \" : Trim(lnk_with_customer.LAST_NAME)"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "REGION"
         SqlType "12"
         Precision "20"
         Scale "0"
         Nullable "1"
         Derivation "lnk_with_customer.REGION"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "REGION_KEY"
         SqlType "12"
         Precision "20"
         Scale "0"
         Nullable "1"
         Derivation "UpCase(lnk_with_customer.REGION)"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "ORDER_MONTH"
         SqlType "12"
         Precision "7"
         Scale "0"
         Nullable "1"
         Derivation "DateToString(lnk_with_customer.ORDER_DATE, \"%yyyy-%mm\")"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "AMOUNT_USD"
         SqlType "3"
         Precision "12"
         Scale "2"
         Nullable "1"
         Derivation "svAmountUsd"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "IS_LARGE"
         SqlType "4"
         Precision "1"
         Scale "0"
         Nullable "1"
         Derivation "If svAmountUsd >= 100 Then 1 Else 0"
      END DSSUBRECORD
   END DSRECORD

