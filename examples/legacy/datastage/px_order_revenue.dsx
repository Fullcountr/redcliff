BEGIN HEADER
   CharacterSet "CP1252"
   ExportingTool "IBM InfoSphere DataStage Export"
   ToolVersion "8"
   ServerName "DEMO"
   ToolInstanceID "REDCLIFF_DEMO"
   MDISVersion "1.0"
