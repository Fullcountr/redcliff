      OLEType "CCustomStage"
      Readonly "0"
      Name "flt_live"
      InputPins "V0S3P1"
      OutputPins "V0S3P2|V0S3P3"
      StageType "PxFilter"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "where"
