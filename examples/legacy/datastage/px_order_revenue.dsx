BEGIN DSJOB
   Identifier "px_order_revenue"
   DateModified "2026-10-12"
   TimeModified "09.00.00"
   BEGIN DSRECORD
      Identifier "ROOT"
      OLEType "CJobDefn"
      Readonly "0"
      Name "px_order_revenue"
      Description "Invented example for Redcliff, not from any real system."
      FullDescription =+=+=+=
Orders are deduplicated and filtered, looked up against customers with an email (orders whose
customer isn't found go to a file), prepared in a Transformer, joined to regions on an upper-cased
key, and aggregated two ways: revenue by region (the table is replaced each run) and activity per
customer (insert then update on the key).
=+=+=+=
      NextID "20"
      Container "V0"
      JobVersion "56.0.0"
      BeforeSubr "ExecSH\\/opt/etl/bin/check_landing.sh"
      AfterSubr "DSSendMail\\Order revenue loaded"
      Parameters "CParameters"
      BEGIN DSSUBRECORD
         Name "MinAmount"
         Prompt "Orders below this amount are left out"
         Default "0"
         ParamType "3"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "FxRate"
         Prompt "Order currency to USD"
         Default "1.0"
         ParamType "3"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "OutDir"
         Prompt "Folder for reject files"
         Default "out"
         ParamType "4"
      END DSSUBRECORD
      JobType "3"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0"
      OLEType "CContainerView"
      Readonly "0"
      Name "Job"
      StageList "V0S1|V0S2|V0S3|V0S4|V0S5|V0S6|V0S7|V0S8|V0S9|V0S10|V0S11|V0S12|V0S13|V0S14|V0S15|V0S16"
   END DSRECORD

   BEGIN DSRECORD
