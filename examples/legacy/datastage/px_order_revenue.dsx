   BEGIN DSRECORD
      Identifier "V0S13"
      OLEType "CCustomStage"
      Readonly "0"
      Name "agg_region"
      InputPins "V0S13P1"
      OutputPins "V0S13P2"
      StageType "PxAggregator"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "key"
         Value "REGION"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "key"
         Value "MANAGER"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "reduce"
         Value "AMOUNT_USD"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "sum"
         Value "REVENUE"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "reduce"
         Value "IS_LARGE"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "sum"
         Value "LARGE_ORDERS"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "countField"
         Value "ORDER_COUNT"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S13P1"
      OLEType "CCustomInput"
      Readonly "0"
      Name "lnk_for_region"
      Partner "V0S12|V0S12P2"
      LinkType "1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S13P2"
      OLEType "CCustomOutput"
      Readonly "0"
      Name "lnk_region_totals"
      Partner "V0S15|V0S15P1"
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "REGION"
         SqlType "12"
         Precision "20"
         Scale "0"
         Nullable "1"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "MANAGER"
         SqlType "12"
         Precision "50"
         Scale "0"
         Nullable "1"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "REVENUE"
         SqlType "3"
         Precision "14"
