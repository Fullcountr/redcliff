{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fullcountr/redcliff/schema/pipeline.schema.json",
  "title": "Redcliff pipeline spec",
  "description": "Structural schema for editors. The Python validator adds checks a schema cannot express: SQL that parses, inputs that exist, no cycles.",
  "type": "object",
  "required": [
    "name",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 0
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "variables": {
      "type": "object",
      "description": "Variables with default values. ${name} in any node's params is replaced by the value before the spec is checked or compiled; runs can override it (--var NAME=VALUE).",
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$"
    },
    "sql": {
      "type": "string",
      "minLength": 1
    },
    "sqlMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sql"
      }
    },
    "io": {
      "type": "object",
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "csv",
            "parquet",
            "table"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "format": {
            "const": "table"
          }
        }
      },
      "then": {
        "required": [
          "table"
        ]
      },
      "else": {
        "required": [
          "path"
        ]
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "source",
            "filter",
            "select",
            "derive",
            "join",
            "aggregate",
            "union",
            "sql",
            "target"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "params": {
          "type": "object"
        },
        "expect": {
          "type": "array",
          "description": "Data quality checks on this step's rows: not_null, unique, accepted_values, condition or row_count, each with an optional name and severity (error or warn)",
          "items": {
            "type": "object",
            "properties": {
              "not_null": {
                "type": "string"
              },
              "unique": {
                "type": [
                  "string",
                  "array"
                ],
                "items": {
                  "type": "string"
                }
              },
              "accepted_values": {
                "type": "object",
                "required": [
                  "column",
                  "values"
                ],
                "properties": {
                  "column": {
                    "type": "string"
                  },
                  "values": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              },
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "row_count": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_]*$"
              },
              "severity": {
                "enum": [
                  "error",
                  "warn"
                ]
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "source"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "maxItems": 0
              },
              "params": {
                "allOf": [
                  {
                    "$ref": "#/$defs/io"
                  }
                ],
                "properties": {
                  "columns": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {
                      "$ref": "#/$defs/id"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "required": [
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "target"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "minItems": 1,
                "maxItems": 1
              },
              "params": {
                "allOf": [
                  {
                    "$ref": "#/$defs/io"
                  }
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "overwrite",
                      "append",
                      "merge"
                    ]
                  },
                  "pre_sql": {
                    "type": "array",
                    "description": "SQL statements run before writing, on the target platform",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "post_sql": {
                    "type": "array",
                    "description": "SQL statements run after writing, on the target platform",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "keys": {
                    "type": "array",
                    "description": "mode: merge: the columns that identify a row",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/id"
                    }
                  },
                  "delete_when": {
                    "type": "string",
                    "description": "mode: merge: delete matched rows where this SQL holds",
                    "minLength": 1
                  }
                }
              }
            },
            "required": [
              "inputs",
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "filter"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "minItems": 1,
                "maxItems": 1
              },
              "params": {
                "required": [
                  "condition"
                ],
                "properties": {
                  "condition": {
                    "$ref": "#/$defs/sql"
                  }
                }
              }
            },
            "required": [
              "inputs",
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "minItems": 1,
                "maxItems": 1
              },
              "params": {
                "required": [
                  "columns"
                ],
                "properties": {
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/$defs/id"
                    }
                  }
                }
              }
            },
            "required": [
              "inputs",
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "derive"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "minItems": 1,
                "maxItems": 1
              },
              "params": {
                "required": [
                  "columns"
                ],
                "properties": {
                  "columns": {
                    "$ref": "#/$defs/sqlMap"
                  }
                }
              }
            },
            "required": [
              "inputs",
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "join"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "minItems": 2,
                "maxItems": 2
              },
              "params": {
                "required": [
                  "condition"
                ],
                "properties": {
                  "how": {
                    "enum": [
                      "inner",
                      "left",
                      "right",
                      "full"
                    ]
                  },
                  "condition": {
                    "$ref": "#/$defs/sql"
                  }
                }
              }
            },
            "required": [
              "inputs",
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aggregate"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "minItems": 1,
                "maxItems": 1
              },
              "params": {
                "properties": {
                  "group_by": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/id"
                    }
                  },
                  "measures": {
                    "$ref": "#/$defs/sqlMap"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "measures"
                    ]
                  },
                  {
                    "required": [
                      "group_by"
                    ],
                    "properties": {
                      "group_by": {
                        "minItems": 1
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "inputs",
              "params"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "union"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "minItems": 2
              },
              "params": {
                "properties": {
                  "distinct": {
                    "type": "boolean"
                  }
                }
              }
            },
            "required": [
              "inputs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sql"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "$ref": "#/$defs/sql"
                  }
                }
              }
            },
            "required": [
              "params"
            ]
          }
        }
      ]
    }
  }
}
