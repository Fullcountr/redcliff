{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fullcountr/redcliff/model.schema.json",
  "title": "Redcliff data model",
  "description": "Entities, keys and relationships a pipeline loads. See docs/modeling.md.",
  "type": "object",
  "required": [
    "version",
    "name",
    "entities"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 0
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\n\\r]+$"
    },
    "style": {
      "enum": [
        "kimball",
        "data_vault"
      ],
      "default": "kimball"
    },
    "description": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*$"
          }
        }
      }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": [
        "id",
        "attributes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "dimension",
            "fact",
            "hub",
            "link",
            "satellite",
            "table"
          ],
          "default": "table"
        },
        "description": {
          "type": "string"
        },
        "grain": {
          "type": "string",
          "description": "Facts: what one row is."
        },
        "history": {
          "enum": [
            "scd1",
            "scd2"
          ],
          "description": "Dimensions: scd2 (default) keeps every version."
        },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/attribute"
          }
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\n\\r]+$",
          "description": "Where the entity's rows come from: a CSV or Parquet path (relative to the model file) or a table."
        },
        "append": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "pattern": "^[^\\n\\r]+$"},
          "description": "More files or tables with the same columns as 'source' (a month per file, say), loaded together with it."
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "fact"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "grain"
        ]
      }
    },
    "attribute": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "A SQL type, e.g. bigint, varchar, decimal(12,2)."
        },
        "role": {
          "enum": [
            "surrogate_key",
            "durable_key",
            "business_key",
            "measure"
          ]
        },
        "history": {
          "enum": [
            "scd1",
            "scd2"
          ],
          "description": "scd1: corrections overwrite every version."
        },
        "track": {
          "type": "boolean",
          "default": true,
          "description": "false: a change doesn't make a new version."
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "SQL over the entity source's columns. Default: the column of the same name."
        }
      }
    }
  }
}
